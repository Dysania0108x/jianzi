{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "见字",
  "version": "0.1.0",
  "identifier": "com.jianzi.personalarchive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "见字",
      "width": 1280,
      "height": 840,
      "minWidth": 980,
      "minHeight": 680,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "自由写作与私人文字收藏",
    "longDescription": "见字是一款本地优先的中文写作、灵感收藏与私人书单应用。"
  }
}